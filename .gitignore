# build artifacts
backend/freipadel
backend/static/
frontend/build/
frontend/.svelte-kit/
frontend/node_modules/

# runtime data (SQLite db, scraper config)
data/
backend/data/

# legacy/private python scraper (ported to Go in backend/scraper)
logic/

# Claude Code project settings
.claude/

# private scrape connectors — kept out of this repo. Drop *.private.go files
# into backend/scraper/ (copy or symlink) for a real deployment; without them
# the app falls back to the built-in mock source. Their tests and fixtures are
# private too, so a checkout without the connectors still builds `go test ./...`.
backend/scraper/*.private.go
backend/scraper/*.private_test.go
backend/scraper/testdata/

# misc
.DS_Store

*.env
.aider*
