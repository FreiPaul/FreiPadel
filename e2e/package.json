{
  "name": "freipadel-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests: the real Docker image, a Mailpit inbox and the SQLite database.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report .tmp/report",
    "typecheck": "tsc --noEmit",
    "stack:up": "docker compose -f docker-compose.e2e.yml up -d --build --wait",
    "stack:down": "docker compose -f docker-compose.e2e.yml down -v --remove-orphans",
    "stack:logs": "docker compose -f docker-compose.e2e.yml logs -f",
    "screenshots": "SCREENSHOTS=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2"
  }
}
